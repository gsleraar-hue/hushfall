{
  "name": "hushfall",
  "productName": "Hushfall",
  "version": "1.0.16",
  "description": "Ambient sound and soundscapes to focus, unwind and sleep — most of it generated live by the app itself",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Jan-Wolter",
  "scripts": {
    "dev": "node server.js",
    "fetch": "node scripts/fetch-sounds.js",
    "fetch:dry": "node scripts/fetch-sounds.js --dry",
    "icon": "node scripts/make-icon.js",
    "start": "electron .",
    "bump": "node scripts/bump-version.js",
    "dist": "node scripts/bump-version.js && electron-builder --win --publish never",
    "dist:keep": "electron-builder --win --publish never",
    "release": "node scripts/bump-version.js && electron-builder --win --publish always",
    "dist:store": "node scripts/make-icon.js && electron-builder --win appx --publish never"
  },
  "build": {
    "appId": "nl.janwolter.hushfall",
    "productName": "Hushfall",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server.js",
      "scripts/fetch-sounds.js",
      "public/**",
      "!public/sounds/**",
      "!public/library.json",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Hushfall",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Hushfall-portable-${version}.exe"
    },
    "appx": {
      "identityName": "00000000-0000-0000-0000-000000000000",
      "publisher": "CN=Jan-Wolter",
      "publisherDisplayName": "Jan-Wolter",
      "applicationId": "Hushfall",
      "displayName": "Hushfall",
      "backgroundColor": "#0b0f1a",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "lamejs": "^1.2.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
